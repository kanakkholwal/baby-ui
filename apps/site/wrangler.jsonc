{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "baby-ui-site",
	"compatibility_date": "2025-09-01",
	// SvelteKit's server bundle reaches for node: builtins even when the routes do not.
	"compatibility_flags": ["nodejs_compat"],
	// `main` + `assets` is what tells adapter-cloudflare to build for Workers, not Pages.
	"main": ".svelte-kit/cloudflare/_worker.js",
	// No not_found_handling: SvelteKit renders every non-asset route, so an asset miss
	// has to reach the Worker. "404-page" makes the asset router answer instead.
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	"routes": [
		{
			"pattern": "baby-ui.nexonauts.com",
			"custom_domain": true
		}
	]
}
