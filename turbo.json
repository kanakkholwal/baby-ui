{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"//#gen": {
			"cache": false
		},
		"//#emails": {
			"dependsOn": ["//#gen"],
			"inputs": [
				"scripts/emails/**",
				"packages/tokens/src/**",
				"packages/ui-react/src/email-*/**",
				"packages/ui-svelte/src/lib/email-*/**",
				"packages/demos/src/data/email-samples.ts",
				"pro/packages/react/src/email-*/**",
				"pro/packages/svelte/src/lib/email-*/**",
				"pro/packages/demos/src/data/email-samples.ts"
			],
			"outputs": [
				"apps/site/src/lib/generated/emails/**",
				"apps/site/src/lib/generated/emails-pro/**"
			]
		},
		"build": {
			"dependsOn": ["//#gen", "//#emails", "^build", "^registry"],
			"env": ["VITE_POSTHOG_KEY", "BABY_UI_REGISTRY_URL", "BABY_UI_SITE_URL"],
			"outputs": ["dist/**", ".svelte-kit/**", "build/**", ".docvia/**"]
		},
		"registry": {
			"dependsOn": ["//#gen", "^build"],
			"env": [
				"BABY_UI_REGISTRY_URL",
				"BABY_UI_SITE_URL",
				"BABY_UI_REGISTRY_OUT",
				"VITE_SHOW_PRO"
			],
			"inputs": [
				"src/**",
				"../tokens/src/**",
				"../registry-schema/src/**",
				"../ui-react/src/**",
				"../ui-svelte/src/**",
				"../../apps/site/src/docs/**"
			],
			"outputs": [
				"../../apps/site/static/r/**",
				"../../apps/site/static/svelte/**",
				"../../apps/site/static/llms.txt",
				"../../apps/site/src/lib/generated/**",
				"../../THIRD_PARTY_LICENSES.md"
			]
		},
		"check": {
			"dependsOn": ["//#gen", "//#emails", "^build", "^registry"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["//#gen", "//#emails", "^registry"]
		}
	}
}
