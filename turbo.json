{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build", "^registry"],
			"env": ["VITE_POSTHOG_KEY", "BABY_UI_REGISTRY_URL", "BABY_UI_SITE_URL"],
			"outputs": ["dist/**", ".svelte-kit/**", "build/**", ".docvia/**"]
		},
		"registry": {
			"dependsOn": ["^build"],
			"env": ["BABY_UI_REGISTRY_URL", "BABY_UI_SITE_URL"],
			"inputs": [
				"src/**",
				"../tokens/src/**",
				"../registry-schema/src/**",
				"../ui-react/src/**",
				"../ui-svelte/src/**",
				"../../apps/site/src/docs/**"
			],
			"outputs": [
				"../../apps/site/static/r/**",
				"../../apps/site/static/svelte/**",
				"../../apps/site/static/llms.txt",
				"../../apps/site/src/lib/generated/**",
				"../../THIRD_PARTY_LICENSES.md"
			]
		},
		"check": {
			"dependsOn": ["^build", "^registry"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^registry"]
		}
	}
}
