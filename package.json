{
	"name": "baby-ui",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.1.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "turbo run build",
		"check": "node scripts/check-comments.mjs && node scripts/check-import-extensions.mjs && turbo run check",
		"component": "node scripts/create-component.mjs",
		"dev": "turbo run dev --filter=@baby-ui/site",
		"dev:list": "portless list",
		"dev:stop": "portless prune",
		"playground": "turbo run dev --filter=@baby-ui/playground-*",
		"registry": "node scripts/sync-fonts.mjs && turbo run registry",
		"lint": "biome check .",
		"format": "biome check --write .",
		"fonts": "node scripts/sync-fonts.mjs",
		"size": "node scripts/check-worker-size.mjs",
		"test:chart": "node --test scripts/test-chart-core.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "catalog:",
		"cross-env": "^10.1.0",
		"portless": "^0.15.6",
		"turbo": "^2.11.1",
		"typescript": "catalog:"
	}
}
